# ---------------------------------------------------------------- Click-Through per X11-Input-Shape (Legacy)
class InputShape:
    """Nur ein Rechteck des Fensters nimmt Maus an (XShapeCombineRectangles, ShapeInput). Leer = alles
    geht durch. Nur unter XWayland/X11."""

    class XRect(ctypes.Structure):
        _fields_ = [("x", ctypes.c_short), ("y", ctypes.c_short), ("w", ctypes.c_ushort), ("h", ctypes.c_ushort)]

    def __init__(self) -> None:
        self.ok = False
        if QGuiApplication.platformName() != "xcb":
            return
        try:
            self.x11 = ctypes.CDLL("libX11.so.6")
            self.xext = ctypes.CDLL("libXext.so.6")
            self.x11.XOpenDisplay.restype = ctypes.c_void_p
            self.x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
            self.x11.XFlush.argtypes = [ctypes.c_void_p]
            self.xext.XShapeCombineRectangles.argtypes = [
                ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_int,
                ctypes.POINTER(self.XRect), ctypes.c_int, ctypes.c_int, ctypes.c_int]
            self.dpy = self.x11.XOpenDisplay(None)
            self.ok = bool(self.dpy)
        except OSError:
            pass

    def set(self, wid: int, rects: list[QRect] | None) -> None:
        """rects None = ganzes Fenster klickbar, [] = nichts."""
        if not self.ok:
            return
        SHAPE_INPUT, SHAPE_SET = 2, 0
        if rects is None:
            rects = [QRect(0, 0, 32767, 32767)]
        arr = (self.XRect * max(1, len(rects)))(*[self.XRect(r.x(), r.y(), r.width(), r.height()) for r in rects])
        self.xext.XShapeCombineRectangles(self.dpy, wid, SHAPE_INPUT, 0, 0, arr, len(rects), SHAPE_SET, 0)
        self.x11.XFlush(self.dpy)


# ---------------------------------------------------------------- Fenster der Meter-Oberfläche
class Host(QObject):
    """Objekt "host" im QWebChannel jedes Meter-Fensters: call(cmd, argsJson) → JSON, Signal event."""

    event = Signal(str, str)

    def __init__(self, win: A2Window) -> None:
        super().__init__(win)
        self.win = win

    @Slot(str, str, result=str)
    def call(self, cmd: str, args_json: str) -> str:
        return self.win.overlay.call_json(self.win, cmd, args_json)


class A2Window(QWebEngineView):
    """Fenster mit der Meter-Oberfläche: Details, Verlauf, Einstellungen – und im Legacy-Betrieb das Meter."""

    def __init__(self, overlay: Overlay, label: str, view: str) -> None:
        super().__init__()
        self.overlay, self.label, self.view = overlay, label, view
        self.locked = False
        self.card_open = False  # Karte im Meter offen: auch gesperrt ganz klickbar
        self.lock_rect = QRect()
        self.setAttribute(Qt.WA_TranslucentBackground)
        # Werkzeugfenster (Details, Verlauf, Einstellungen) beim Schließen freigeben: versteckt liefen
        # ihre Seiten weiter (Event-Stream, Abfragen alle 1–10 s, Details-Neuberechnung alle 2 s)
        self.setAttribute(Qt.WA_DeleteOnClose, label != "main")
        flags = Qt.FramelessWindowHint
        if label == "main":
            flags |= Qt.Tool | Qt.WindowStaysOnTopHint  # nicht in der Taskleiste
            self.setWindowTitle(MAIN_TITLE)
        else:
            self.setWindowTitle(f"NexBoard – {view.capitalize()}")
        self.setWindowFlags(flags)
        self.setWindowIcon(overlay.icon)

        page = QWebEnginePage(overlay.profile, self)
        page.setBackgroundColor(QColor(0, 0, 0, 0))
        script = QWebEngineScript()
        script.setName("deckbar-window")
        script.setInjectionPoint(QWebEngineScript.DocumentCreation)
        script.setWorldId(QWebEngineScript.MainWorld)
        script.setRunsOnSubFrames(False)
        script.setSourceCode(overlay.qwebchannel_js + f"\nwindow.__DECKBAR_WINDOW__ = {json.dumps({'label': label, 'view': view})};")
        page.scripts().insert(script)
        self.host = Host(self)
        channel = QWebChannel(page)
        channel.registerObject("host", self.host)
        page.setWebChannel(channel)
        self.setPage(page)
        self.setContextMenuPolicy(Qt.NoContextMenu)
        self.url = QUrl(overlay.url)
        if view != "main":
            self.url.setQuery(f"view={view}")
        # Daemon noch nicht da (Autostart vor dem Daemon, Neustart): später erneut laden
        self.loadFinished.connect(lambda ok: ok or QTimer.singleShot(3000, lambda: self.load(self.url)))
        self.load(self.url)

    def emit(self, name: str, payload=None) -> None:
        self.host.event.emit(name, json.dumps(payload) if payload is not None else "")

    def apply_lock(self) -> None:
        if self.label != "main" or not self.isVisible():
            return
        rects = None
        if self.locked and not self.card_open:
            rects = [self.lock_rect] if self.lock_rect.isValid() else []
        self.overlay.shape.set(int(self.winId()), rects)

    def showEvent(self, e) -> None:
        super().showEvent(e)
        QTimer.singleShot(0, self.apply_lock)

    def closeEvent(self, e) -> None:
        self.overlay.remember(self)
        super().closeEvent(e)


# ---------------------------------------------------------------- layer-shell-Fläche
class LayerHost(QObject):
    """Kontext-Objekt „host“ in Overlay.qml: Modus, Monitor, Eingabe-Region, Fenster-Befehle des Meters."""

    modeChanged = Signal()
    screenChanged = Signal()
    readyChanged = Signal()

    def __init__(self, overlay: Overlay, page: QUrl, start_mode: str) -> None:
        super().__init__()
        self.overlay = overlay
        self._page = page
        self._mode = start_mode if start_mode in ("click", "lock") else "click"
        self.last = self._mode  # Modus vor dem Bearbeiten
        self.regions: dict[str, list[QRect]] = {"click": [], "lock": []}
        self.window = None
        self._screen = None
        self._ready = False

    @Property(bool, notify=readyChanged)
    def ready(self) -> bool:
        return self._ready

    @Slot()
    def pageReady(self) -> None:
        if not self._ready:
            self._ready = True
            self.readyChanged.emit()

    @Slot()
    def pageGone(self) -> None:
        """Neu laden beginnt: Seite verstecken und nichts mehr abfangen, bis sie sich meldet."""
        self.regions = {"click": [], "lock": []}
        if self._ready:
            self._ready = False
            self.readyChanged.emit()
        if self._mode != "edit":
            self.apply_input()

    @Property(QObject, notify=screenChanged)
    def screen(self):
        return self._screen

    def set_screen(self, screen) -> None:
        if screen is not self._screen:
            self._screen = screen
            self.screenChanged.emit()

    @Property(str, notify=modeChanged)
    def mode(self) -> str:
        return self._mode

    @Property(QUrl, constant=True)
    def pageUrl(self) -> QUrl:
        return self._page

    def set_mode(self, mode: str) -> None:
        if mode not in MODES or mode == self._mode:
            return
        if mode != "edit":
            self.last = mode
        self._mode = mode
        self.apply_input()
        self.modeChanged.emit()
        self.overlay.mode_changed(mode)

    def apply_input(self) -> None:
        """Eingabe-Region: alles (edit), nur Widgets mit data-click (click), nur Schloss (lock)."""
        w = self.window
        if w is None:
            return
        if self._mode == "edit":
            w.setFlag(Qt.WindowTransparentForInput, False)
            w.setMask(QRegion())  # leere Maske = keine Maske = ganze Fläche
            return
        rects = self.regions.get(self._mode) or []
        if not rects:
            # zuerst die Flagge, sonst ist kurz die ganze Fläche klickbar (13.10. gemessen)
            w.setFlag(Qt.WindowTransparentForInput, True)
            w.setMask(QRegion())
            return
        region = QRegion()
        for r in rects:
            region = region.united(QRegion(r))
        w.setFlag(Qt.WindowTransparentForInput, False)
        w.setMask(region)

    @Slot(str)
    def setRegions(self, text: str) -> None:
        try:
            data = json.loads(text)
            regions = {k: [QRect(*(int(round(v)) for v in r)) for r in data.get(k) or []] for k in ("click", "lock")}
        except (ValueError, TypeError, AttributeError):
            return
        if regions == self.regions:
            return  # unverändert: kein neues setMask/Commit
        self.regions = regions
        if self._mode != "edit":
            self.apply_input()

    @Slot(str)
    def requestMode(self, mode: str) -> None:
        self.set_mode(mode)

    @Slot()
    def finishEdit(self) -> None:
        self.set_mode(self.last)

    @Slot(str, str, result=str)
    def call(self, cmd: str, args_json: str) -> str:
        return self.overlay.call_json(None, cmd, args_json)

    @Slot(str)
    def log(self, text: str) -> None:
        if os.environ.get("DECKBAR_OVERLAY_DEBUG"):
            print(f"[seite] {text}", flush=True)


# ---------------------------------------------------------------- Fokus (KWin)
@ClassInfo({"D-Bus Interface": FOCUS_DBUS})
class FocusWatch(QObject):
    """Lädt das KWin-Skript focus.js und nimmt dessen Meldungen (aktives Fenster) über D-Bus an.
    Ohne KWin (anderer Compositor) bleibt ok = False und das Overlay einfach immer sichtbar."""

    def __init__(self, overlay: Overlay) -> None:
        super().__init__()
        self.overlay = overlay
        self.bus = QDBusConnection.sessionBus()
        self.ok = (self.bus.isConnected() and self.bus.registerService(FOCUS_DBUS)
                   and self.bus.registerObject("/Focus", self, QDBusConnection.ExportAllSlots)
                   and self._load_script())
        if not self.ok:
            print("Fokus-Erkennung nicht verfügbar (kein KWin?), Overlay bleibt sichtbar", file=sys.stderr, flush=True)

    def _scripting(self) -> QDBusInterface:
        return QDBusInterface("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", self.bus)

    def _load_script(self) -> bool:
        s = self._scripting()
        if not s.isValid():
            return False
        s.call("unloadScript", FOCUS_SCRIPT)  # Rest eines abgestürzten Laufs
        args = s.call("loadScript", str(HERE / "focus.js"), FOCUS_SCRIPT).arguments()
        if not args or not isinstance(args[0], int) or args[0] < 0:
            return False
        QDBusInterface("org.kde.KWin", f"/Scripting/Script{args[0]}", "org.kde.kwin.Script", self.bus).call("run")
        return True

    def unload(self) -> None:
        if self.ok:
            self._scripting().call("unloadScript", FOCUS_SCRIPT)
            self.ok = False

    @Slot(str, str, str)
    def activeWindow(self, cls: str, caption: str, pid: str) -> None:
        self.overlay.on_focus(cls, caption, pid)


# ---------------------------------------------------------------- Anwendung
class Overlay(QObject):
    def __init__(self, app: QApplication, backend: str) -> None:
        super().__init__()
        self.app = app
        self.backend = backend
        self.url = daemon_url()
        self.store = QSettings("deckbar", "overlay")
        self.icon = QIcon(str(ICON)) if ICON.is_file() else QIcon.fromTheme("utilities-system-monitor")
        self.shape = InputShape()
        f = QFile(":/qtwebchannel/qwebchannel.js")
        f.open(QIODevice.ReadOnly)
        self.qwebchannel_js = bytes(f.readAll()).decode()
        data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "deckbar" / "overlay"
        self.profile = QWebEngineProfile("deckbar-overlay", self)  # gemeinsames localStorage aller Fenster
        self.profile.setPersistentStoragePath(str(data / "storage"))
        self.profile.setCachePath(str(data / "cache"))
        self.profile.settings().setAttribute(QWebEngineSettings.LocalStorageEnabled, True)
        self.windows: dict[str, A2Window] = {}
        self.pending: dict[str, dict] = {}
        self.seq = 0
        self.main: A2Window | None = None
        self.layer: LayerHost | None = None
        self.surface = None
        self.focus: FocusWatch | None = None
        self.manual_hidden = False  # per Befehl/Tray verborgen
        self.focus_away = False  # anderes Fenster als AION 2 aktiv
        self.autohide = bool(LAYOUT.get("hide_unfocused", True))
        self.focus_timer = QTimer(self)
        self.focus_timer.setSingleShot(True)
        self.focus_timer.timeout.connect(self._focus_left)
        self._tray()
        if backend == "layer":
            self._layer()
        else:
            self.main = self._window("main", "main")
            ensure_kwin_rule()

    # ------------------------------------------------------------ layer-shell
    def _layer(self) -> None:
        from PySide6.QtQml import QQmlApplicationEngine

        self.layer = LayerHost(self, QUrl(self.url + "__deckbar__/overlay/"), str(LAYOUT.get("start_mode") or "click"))
        self.layer.set_screen(self._target_screen())
        self.engine = QQmlApplicationEngine()
        self.engine.rootContext().setContextProperty("host", self.layer)
        self.engine.load(QUrl.fromLocalFile(str(HERE / "Overlay.qml")))
        if not self.engine.rootObjects():
            raise RuntimeError("Overlay.qml ließ sich nicht laden (layer-shell-qt installiert?)")
        self.surface = self.engine.rootObjects()[0]
        self.layer.window = self.surface
        self._place_on_screen()
        QGuiApplication.instance().screenAdded.connect(lambda *_: QTimer.singleShot(500, self._place_on_screen))
        QGuiApplication.instance().screenRemoved.connect(lambda *_: QTimer.singleShot(500, self._place_on_screen))
        self.layer.apply_input()  # vor dem Zeigen: sonst blockiert die Fläche kurz das Spiel
        self.surface.show()
        self.lock_action.setChecked(self.layer.mode == "lock")
        self.focus = FocusWatch(self)  # meldet sofort das aktive Fenster

    # ------------------------------------------------------------ Fokus
    def on_focus(self, cls: str, caption: str, pid: str) -> None:
        if pid == str(os.getpid()):
            return  # eigene Fenster (Fläche beim Bearbeiten, Details, Einstellungen) ändern nichts
        if cls == GAME_CLASS or caption == GAME_TITLE:
            self.focus_timer.stop()
            if self.focus_away:
                self.focus_away = False
                self._sync_surface()
        elif not self.focus_away:
            self.focus_timer.start(FOCUS_HIDE_MS)

    def _focus_left(self) -> None:
        self.focus_away = True
        self._sync_surface()

    def _sync_surface(self) -> None:
        """Fläche zeigen, solange sie nicht von Hand verborgen ist und das Spiel den Fokus hat
        (oder Autohide aus ist, oder gerade bearbeitet wird)."""
        if self.surface is None:
            return
        want = not self.manual_hidden and (self.layer.mode == "edit" or not (self.autohide and self.focus_away))
        if want == self.surface.isVisible():
            return
        if want:
            self.layer.apply_input()
            self.surface.show()
        else:
            self.surface.hide()

    @staticmethod
    def _target_screen():
        want = str(LAYOUT.get("screen") or "") or kde_primary()
        return next((s for s in QGuiApplication.screens() if s.name() == want), None) or QGuiApplication.primaryScreen()

    def _place_on_screen(self) -> None:
        screen = self._target_screen()
        if screen is None or self.surface is None:
            return
        self.layer.set_screen(screen)
        self.surface.setScreen(screen)
        self.surface.resize(screen.size())

    def mode_changed(self, mode: str) -> None:
        self.lock_action.blockSignals(True)
        self.lock_action.setChecked(mode == "lock")
        self.lock_action.blockSignals(False)
        self.edit_action.blockSignals(True)
        self.edit_action.setChecked(mode == "edit")
        self.edit_action.blockSignals(False)
        if mode == "edit":
            self.manual_hidden = False
        self._sync_surface()

    # ------------------------------------------------------------ Fenster
    def _window(self, label: str, view: str) -> A2Window:
        w = A2Window(self, label, view)
        self.windows[label] = w
        w.destroyed.connect(lambda *_: self.windows.pop(label, None))
        geo = self.store.value(f"geometry/{label if not label.startswith('details-') else 'details'}")
        if label == "main":
            w.resize(400, 300)
            pos = self.store.value("geometry/main-pos")
            if isinstance(pos, QPoint):
                w.move(pos)
        elif isinstance(geo, QByteArray) and not label.startswith("details-"):
            w.restoreGeometry(geo)
        else:
            width, height, minw, minh = TOOL_SIZES.get(view, (1180, 760, 520, 360))
            w.resize(width, height)
            w.setMinimumSize(minw, minh)
            if label.startswith("details-"):  # Kampf-Fenster kaskadieren
                n = sum(1 for k in self.windows if k.startswith("details-"))
                w.move(w.pos() + QPoint(28 * n, 28 * n))
        return w

    def remember(self, w: A2Window) -> None:
        if w.label == "main":
            self.store.setValue("geometry/main-pos", w.pos())
        elif not w.label.startswith("details-"):
            self.store.setValue(f"geometry/{w.label}", w.saveGeometry())

    def tool(self, label: str, view: str) -> A2Window:
        return self.windows.get(label) or self._window(label, view)

    def reveal(self, w: A2Window) -> None:
        w.show()
        w.raise_()
        w.activateWindow()

    def visible(self) -> bool:
        if self.surface is not None:
            return self.surface.isVisible()
        return bool(self.main and self.main.isVisible())

    def show_main(self) -> None:
        if self.surface is not None:
            # ausdrücklich zeigen gilt auch ohne Spielfokus, bis zum nächsten Fensterwechsel
            self.manual_hidden = False
            self.focus_timer.stop()
            self.focus_away = False
            self._sync_surface()
        elif self.main:
            self.reveal(self.main)

    def toggle(self) -> None:
        if self.visible():
            self.hide_all()
        else:
            self.show_main()

    def hide_all(self) -> None:
        if self.surface is not None:
            self.manual_hidden = True
            if self.layer.mode == "edit":
                self.layer.finishEdit()
            self.surface.hide()
        for w in list(self.windows.values()):
            if w.label == "main":
                if w.isVisible():
                    self.remember(w)
                    w.hide()
            else:
                w.close()  # merkt die Position (closeEvent) und gibt das Fenster frei

    def request_details(self, payload: dict) -> None:
        kind = payload.get("kind")
        if kind == "history":
            label, view = "history", "history"
        elif kind == "fight":
            label, view = "details-" + re.sub(r"[^A-Za-z0-9]", "_", str(payload.get("fightId"))), "details"
        else:
            label, view = "details", "details"
        self.seq += 1
        payload = {**payload, "seq": self.seq}
        w = self.windows.get(label)
        if w:
            self.reveal(w)
            w.emit("details-request", payload)
        else:
            self.pending[label] = payload
            self.reveal(self.tool(label, view))

    def on_screen(self, w: A2Window, index: int) -> None:
        screens = QGuiApplication.screens()
        if 0 <= index < len(screens):
            g = screens[index].availableGeometry()
            w.move(g.center() - QPoint(w.width() // 2, w.height() // 2))

    # ------------------------------------------------------------ Fenster-Commands der Seiten
    def call_json(self, w: A2Window | None, cmd: str, args_json: str) -> str:
        try:
            args = json.loads(args_json or "{}")
            return json.dumps({"result": self.command(w, cmd, args)})
        except Exception as e:  # noqa: BLE001 – die Seite bekommt den Fehler als Reject
            return json.dumps({"error": str(e)})

    def command(self, w: A2Window | None, cmd: str, a: dict):
        """w = Meter-Fenster der Oberfläche, None = Meter in der layer-shell-Fläche (Seite übernimmt
        dort Ziehen, Größe und Sperre selbst und reicht nur den Rest durch)."""
        handle = w.windowHandle() if w else None
        match cmd:
            case "start_drag":
                if handle and not w.locked:
                    handle.startSystemMove()
            case "start_tool_drag":
                if handle:
                    handle.startSystemMove()
            case "window_resize_drag":
                if handle and a.get("direction") in EDGES:
                    handle.startSystemResize(EDGES[a["direction"]])
            case "begin_tool_resize":
                if w:
                    w.setMinimumSize(int(a.get("minWidth") or 0), int(a.get("minHeight") or 0))
            case "begin_window_resize":
                return False
            case "finish_window_resize":
                return True
            case "resize_window":
                if w and w.label == "main":
                    # CSS-Pixel = logische Pixel in Qt; obere linke Ecke bleibt stehen
                    w.setFixedSize(max(1, math.ceil(float(a.get("width") or 1))), max(1, math.ceil(float(a.get("height") or 1))))
                    QTimer.singleShot(0, w.apply_lock)
            case "overlay_lock_supported":
                return self.shape.ok or self.layer is not None
            case "set_overlay_locked":
                if w:
                    w.locked = bool(a.get("locked"))
                    self.lock_action.setChecked(w.locked)
                    w.apply_lock()
            case "set_overlay_card_open":
                if w:
                    w.card_open = bool(a.get("open"))
                    w.apply_lock()
            case "set_lock_button_rect":
                if w:
                    w.lock_rect = QRect(math.floor(float(a.get("x") or 0)), math.floor(float(a.get("y") or 0)),
                                        math.ceil(float(a.get("width") or 0)), math.ceil(float(a.get("height") or 0)))
                    w.apply_lock()
            case "main_window_ready" | "window_show":
                if w:
                    w.show()
            case "tool_window_ready" | "window_focus":
                if w:
                    self.reveal(w)
                return True
            case "details_window_ready":
                pass
            case "open_settings_window":
                s = self.windows.get("settings")
                if s:
                    s.emit("settings-shown")
                self.reveal(s or self.tool("settings", "settings"))
            case "close_settings_window":
                if s := self.windows.get("settings"):
                    s.close()
            case "request_details_view":
                self.request_details(a.get("payload") or {})
            case "take_pending_details_request":
                return self.pending.pop(w.label, None) if w else None
            case "open_details_window":
                d = self.tool("details", "details")
                self.on_screen(d, int(a.get("monitorIndex") or 0))
                self.reveal(d)
            case "close_details_window":
                if d := self.windows.get("details"):
                    d.close()
            case "close_tool_window":
                if w:
                    w.close()
            case "list_monitors":
                return self.monitors()
            case "open_url":
                QDesktopServices.openUrl(QUrl(str(a.get("url"))))
            case "quit_app":
                self.hide_all()  # Overlay bleibt im Tray, Beenden dort
            case "capture_screenshot":
                return self.screenshot(w, a)
            case _:
                raise RuntimeError(f"unbekannter Fenster-Command {cmd}")
        return None

    def monitors(self) -> list[dict]:
        screens = QGuiApplication.screens()
        primary = QGuiApplication.primaryScreen()
        ordered = [primary] + [s for s in screens if s is not primary]
        pg = primary.geometry()
        out = []
        for i, s in enumerate(ordered):
            g, dpr = s.geometry(), s.devicePixelRatio()
            side = ""
            if s is not primary:
                side = ("left" if g.right() < pg.left() else "right" if g.left() > pg.right()
                        else "above" if g.bottom() < pg.top() else "below")
            out.append({"index": i, "name": s.name(), "x": round(g.x() * dpr), "y": round(g.y() * dpr),
                        "width": round(g.width() * dpr), "height": round(g.height() * dpr),
                        "scaleFactor": dpr, "isPrimary": s is primary, "side": side})
        return out

    def screenshot(self, w: A2Window | None, a: dict) -> dict:
        if w is None and self.surface is not None:
            img = self.surface.grabWindow()
            dpr = img.devicePixelRatio() or 1
            rect = QRect(round(float(a.get("x") or 0) * dpr), round(float(a.get("y") or 0) * dpr),
                         round(float(a.get("width") or 1) * dpr), round(float(a.get("height") or 1) * dpr))
            img = img.copy(rect)
            QApplication.clipboard().setImage(img)
            save = img.save
        else:
            rect = QRect(int(a.get("x") or 0), int(a.get("y") or 0), int(a.get("width") or w.width()), int(a.get("height") or w.height()))
            pix = w.grab(rect)
            QApplication.clipboard().setPixmap(pix)
            save = pix.save
        path = None
        if a.get("saveFile") and a.get("folder"):
            name = re.sub(r"[/\\\0]", "_", str(a.get("filename") or "a2tools.png"))
            path = str(Path(str(a["folder"])).expanduser() / name)
            save(path, "PNG")
        return {"clipboard": True, "file": path}

    # ------------------------------------------------------------ Tray und Befehle
    def _tray(self) -> None:
        menu = QMenu()
        menu.addAction("Overlay zeigen/verbergen", self.toggle)
        self.edit_action = QAction("Bearbeiten (Widgets verschieben)", menu, checkable=True)
        self.edit_action.toggled.connect(self._edit_from_tray)
        menu.addAction(self.edit_action)
        self.lock_action = QAction("Durchklicken (gesperrt)", menu, checkable=True)
        self.lock_action.toggled.connect(self._lock_from_tray)
        menu.addAction(self.lock_action)
        menu.addSeparator()
        menu.addAction("Details", lambda: self.request_details({"kind": "all"}))
        menu.addAction("Verlauf", lambda: self.request_details({"kind": "history"}))
        menu.addAction("Meter-Einstellungen", lambda: self.command(self.main, "open_settings_window", {}))
        menu.addAction("NexBoard-Einstellungen öffnen …", lambda: QDesktopServices.openUrl(
            QUrl(f"http://localhost:{daemon_port()}/#/aion2.overlay")))
        menu.addSeparator()
        self.update_action = menu.addAction("Keine Updates", self.run_update)
        self.update_action.setEnabled(False)
        menu.addAction("Nach Updates suchen", lambda: self.api("POST", "/api/updates/check", self.on_updates))
        menu.addSeparator()
        menu.addAction("Beenden", self.app.quit)
        menu.aboutToShow.connect(lambda: self.api("GET", "/api/updates", self.on_updates))
        self.edit_action.setVisible(self.backend == "layer")
        self.tray = QSystemTrayIcon(self.icon, self)
        self.tray.setToolTip("NexBoard Overlay")
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(lambda r: self.toggle() if r == QSystemTrayIcon.Trigger else None)
        self.tray.messageClicked.connect(self.run_update)
        self.tray.show()
        # Update-Stand vom Daemon (der prüft täglich)
        self.net = QNetworkAccessManager(self)
        self.daemon = f"http://127.0.0.1:{daemon_port()}"
        self.updates: dict = {}
        self.update_timer = QTimer(self)
        self.update_timer.timeout.connect(lambda: self.api("GET", "/api/updates", self.on_updates))
        self.update_timer.start(10 * 60 * 1000)
        QTimer.singleShot(150 * 1000, lambda: self.api("GET", "/api/updates", self.on_updates))

    # ------------------------------------------------------------ Updates
    def api(self, method: str, path: str, done=None) -> None:
        req = QNetworkRequest(QUrl(self.daemon + path))
        req.setHeader(QNetworkRequest.ContentTypeHeader, "application/json")
        reply = self.net.post(req, b"{}") if method == "POST" else self.net.get(req)

        def finished() -> None:
            body = bytes(reply.readAll()).decode(errors="replace")
            ok = reply.error() == QNetworkReply.NoError
            reply.deleteLater()
            try:
                data = json.loads(body) if body else {}
            except ValueError:
                data = {}
            if done:
                done(data if ok else {"error": data.get("error") or reply.errorString()})

        reply.finished.connect(finished)

    def on_updates(self, u: dict) -> None:
        if "error" in u and "available" not in u:
            return  # Daemon nicht erreichbar oder Modul aus: alten Stand behalten
        self.updates = u
        parts = []
        d, a = u.get("deckbar") or {}, u.get("a2tools") or {}
        if d.get("behind"):
            parts.append(f"NexBoard +{d['behind']}")
        if a.get("newer"):
            parts.append(f"A2Tools {a.get('latest')}")
        if u.get("running"):
            self.update_action.setText("Update läuft …")
            self.update_action.setEnabled(False)
        elif u.get("available"):
            self.update_action.setText(f"Jetzt aktualisieren ({', '.join(parts)})")
            self.update_action.setEnabled(True)
        else:
            self.update_action.setText("Keine Updates" + (" (Prüfung fehlgeschlagen)" if u.get("error") else ""))
            self.update_action.setEnabled(False)
        self.tray.setToolTip("NexBoard Overlay" + (f"\nUpdate verfügbar: {', '.join(parts)}" if u.get("available") else ""))
        # Einmal je neuem Stand melden
        key = f"{d.get('latest') if d.get('behind') else ''}|{a.get('latest') if a.get('newer') else ''}"
        if u.get("available") and self.store.value("notifiedUpdate") != key:
            self.store.setValue("notifiedUpdate", key)
            self.tray.showMessage("NexBoard: Update verfügbar",
                                  f"{', '.join(parts)}. Zum Aktualisieren hier klicken oder im Tray-Menü.",
                                  QSystemTrayIcon.Information, 15000)

    def run_update(self) -> None:
        if not self.updates.get("available") or self.updates.get("running"):
            return
        self.update_action.setText("Update läuft …")
        self.update_action.setEnabled(False)
        self.api("POST", "/api/updates/run", lambda r: r.get("error") and self.tray.showMessage(
            "NexBoard-Update", f"Ging nicht: {r['error']}", QSystemTrayIcon.Warning, 10000))

    def _edit_from_tray(self, on: bool) -> None:
        if self.layer is not None and on != (self.layer.mode == "edit"):
            self.run("edit")

    def _lock_from_tray(self, on: bool) -> None:
        if self.layer is not None:
            self.layer.set_mode("lock" if on else "click")
            return
        if self.main and self.main.locked != on:
            # Über die Seite, damit Schloss-Knopf und Einstellung mitziehen
            self.main.page().runJavaScript(
                f"window.javaBridge?.setSetting?.('dpsMeter.overlayLocked', '{str(on).lower()}');"
                f"document.querySelector('.lockBtn, #lockBtn')?.click();")
            self.main.locked = on
            self.main.apply_lock()

    def run(self, cmd: str) -> None:
        match cmd:
            case "toggle":
                self.toggle()
            case "show":
                self.show_main()
            case "hide":
                self.hide_all()
            case "edit":
                if self.layer is not None:
                    if self.layer.mode == "edit":
                        self.layer.finishEdit()
                    else:
                        self.show_main()
                        self.layer.set_mode("edit")
            case "lock" | "click":
                if self.layer is not None:
                    self.layer.set_mode(cmd)
                else:
                    self._lock_from_tray(cmd == "lock")
            case "reload":
                if self.surface is not None:
                    view = self.surface.findChild(QObject, "view")
                    if view is not None:
                        view.reload()
                elif self.main:
                    self.main.reload()
            case "details":
                self.request_details({"kind": "all"})
            case "history":
                self.request_details({"kind": "history"})
            case "settings":
                self.command(self.main, "open_settings_window", {})
            case "autohide-on" | "autohide-off":
                self.autohide = cmd == "autohide-on"
                self._sync_surface()
            case "quit":
                self.app.quit()


def ensure_kwin_rule() -> None:
    """Legacy: Meter-Fenster über dem Vollbild-Spiel per KWin-Regel Ebene „Overlay“ (wie beim
    A2Tools-Meter). Nur einmal je Fenstertitel anlegen; was der Nutzer danach ändert, bleibt so."""
    store = QSettings("deckbar", "overlay")
    if store.value("kwinRuleTitle") == MAIN_TITLE or not shutil.which("kwriteconfig6"):
        return
    group = "deckbar-overlay"

    def kw(key: str, value: str, grp: str = group) -> None:
        subprocess.run(["kwriteconfig6", "--file", "kwinrulesrc", "--group", grp, "--key", key, value], check=False)

    rules = subprocess.run(["kreadconfig6", "--file", "kwinrulesrc", "--group", "General", "--key", "rules"],
                           capture_output=True, text=True).stdout.strip()
    names = [r for r in rules.split(",") if r]
    kw("Description", "NexBoard DPS-Meter über dem Spiel")
    kw("title", MAIN_TITLE)
    kw("titlematch", "1")  # exakt
    kw("wmclass", APP)  # WM_CLASS ist "deckbar-overlay", "deckbar-overlay" (-name + Programmname)
    kw("wmclasscomplete", "true")
    kw("wmclassmatch", "2")  # enthält
    kw("layer", "overlay")
    kw("layerrule", "2")  # erzwingen
    if group not in names:
        names.append(group)
        kw("rules", ",".join(names), "General")
        kw("count", str(len(names)), "General")
    subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"], check=False, capture_output=True)
    store.setValue("kwinRuleTitle", MAIN_TITLE)  # neuer Titel (Umbenennung) → Regel wird nachgezogen


def kde_primary() -> str:
    """Hauptmonitor laut KDE (Priorität 1). Qt meldet unter Wayland oft einfach den ersten Ausgang."""
    if not shutil.which("kscreen-doctor"):
        return ""
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=3).stdout
        outputs = [o for o in json.loads(out).get("outputs", []) if o.get("enabled")]
        best = min(outputs, key=lambda o: o.get("priority") or 99)
        return str(best.get("name") or "")
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return ""


def send_to_running(cmd: str) -> bool:
    sock = QLocalSocket()
    sock.connectToServer(socket_path())
    if not sock.waitForConnected(500):
        return False
    sock.write(cmd.encode() + b"\n")
    sock.waitForBytesWritten(500)
    sock.disconnectFromServer()
    return True


def main() -> int:
    args = _ARGS
    if any(a in ("h", "help", "-h") for a in args):
        print(__doc__)
        return 0
    cmd = next((a for a in args if a in COMMANDS), None)
    if BACKEND == "layer":
        from PySide6.QtWebEngineQuick import QtWebEngineQuick
        QtWebEngineQuick.initialize()
    QGuiApplication.setAttribute(Qt.AA_ShareOpenGLContexts)
    app = QApplication([sys.argv[0], "-name", APP])
    app.setApplicationName(APP)
    app.setDesktopFileName(APP)
    app.setQuitOnLastWindowClosed(False)
    if send_to_running(cmd or "show"):
        return 0  # läuft schon: Befehl weitergegeben
    if cmd == "quit":
        return 0
    path = socket_path()
    QLocalServer.removeServer(path)
    server = QLocalServer()
    server.setSocketOptions(QLocalServer.UserAccessOption)
    if not server.listen(path):
        print(f"Socket {path}: {server.errorString()}", file=sys.stderr)
    try:
        overlay = Overlay(app, BACKEND)
    except RuntimeError as e:
        print(f"{e} – starte das alte Meter-Fenster: deckbar-overlay --legacy", file=sys.stderr)
        return 1
    print(f"NexBoard-Overlay läuft ({'layer-shell' if BACKEND == 'layer' else 'Legacy-Fenster'})", flush=True)

    def incoming() -> None:
        conn = server.nextPendingConnection()
        conn.readyRead.connect(lambda: [overlay.run(line.strip()) for line in bytes(conn.readAll()).decode().splitlines()])

    server.newConnection.connect(incoming)
    if cmd and cmd not in ("hide",):
        QTimer.singleShot(300, lambda: overlay.run(cmd))
    autosave = QTimer()
    autosave.timeout.connect(lambda: [overlay.remember(w) for w in overlay.windows.values() if w.isVisible()])
    autosave.start(5000)
    if overlay.focus is not None:
        app.aboutToQuit.connect(overlay.focus.unload)
    # SIGTERM (systemctl stop) sauber beenden, damit das KWin-Skript entladen wird. Python-Handler
    # laufen nur, wenn der Interpreter dran ist: das Wakeup-Fd weckt die Qt-Schleife (kein Polling).
    rfd, wfd = os.pipe()
    os.set_blocking(wfd, False)
    signal.set_wakeup_fd(wfd)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: app.quit())
    wake = QSocketNotifier(rfd, QSocketNotifier.Read)
    wake.activated.connect(lambda *_: os.read(rfd, 64))
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
