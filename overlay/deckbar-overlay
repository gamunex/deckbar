def socket_path() -> str:
    """Gleiche Regel wie deckbar_daemon/overlay.py."""
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/deckbar-{os.getuid()}"
    os.makedirs(base, exist_ok=True)
    return str(Path(base) / "deckbar-overlay.sock")


def daemon_port() -> int:
    cfg = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "deckbar" / "config.yaml"
    try:
        m = re.search(r"^port:\s*(\d+)", cfg.read_text(), re.M)
        return int(m.group(1)) if m else 8765
    except OSError:
        return 8765


def daemon_url() -> str:
    """Overlay- und Meter-Oberfläche = Port des Daemons + 1 (config.yaml)."""
    return f"http://127.0.0.1:{daemon_port() + 1}/"


def fetch_layout() -> dict:
    """Overlay-Einstellungen vom Daemon (Monitor, GPU, Startmodus); ohne Daemon Standardwerte."""
    try:
        with urllib.request.urlopen(daemon_url() + "api/overlay/layout", timeout=1.5) as r:
            data = json.loads(r.read())
            return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def choose_backend(args: list[str]) -> str:
    """layer (layer-shell unter Wayland) oder legacy (XWayland-Fenster wie früher)."""
    if "legacy" in args:
        return "legacy"
    if "layer" in args:
        return "layer"
    if not os.environ.get("WAYLAND_DISPLAY"):
        return "legacy"
    if "GNOME" in os.environ.get("XDG_CURRENT_DESKTOP", "").upper():
        return "legacy"  # Mutter kennt kein layer-shell
    from PySide6.QtCore import QLibraryInfo
    qml = Path(QLibraryInfo.path(QLibraryInfo.LibraryPath.QmlImportsPath))
    return "layer" if (qml / "org" / "kde" / "layershell").is_dir() else "legacy"


# Plattform vor dem ersten Qt-Fenster festlegen
_ARGS = [a.removeprefix("--") for a in sys.argv[1:]]
